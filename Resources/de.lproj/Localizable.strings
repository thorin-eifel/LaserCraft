"grbl.setting.0.detail" = "Dauer des Impulses pro Schritt. Minimum 3 µs.";
"grbl.setting.1.detail" = "Kurze Haltezeit beim Anhalten, damit die Mechanik zur Ruhe kommt, bevor die Motoren abgeschaltet werden. Wert 255 hält die Motoren ohne Verzögerung eingeschaltet.";
"grbl.setting.2.detail" = "Invertiert das Schrittsignal. Achsenbit setzen, um zu invertieren (00000ZYX).";
"grbl.setting.3.detail" = "Invertiert das Richtungssignal. Achsenbit setzen, um zu invertieren (00000ZYX).";
"grbl.setting.4.detail" = "Invertiert das Freigabesignal der Schrittmotortreiber.";
"grbl.setting.5.detail" = "Invertiert alle Endschalter-Eingänge.";
"grbl.setting.6.detail" = "Invertiert den Eingang des Tasters.";
"grbl.setting.10.detail" = "Ändert die in Statusberichten enthaltenen Daten.";
"grbl.setting.11.detail" = "Legt fest, wie schnell Grbl aufeinanderfolgende Bewegungen durchfährt. Ein niedrigerer Wert verlangsamt.";
"grbl.setting.12.detail" = "Legt die Genauigkeit von G2/G3-Bögen anhand des Radialfehlers fest. Achtung: Sehr kleine Werte können die Leistung beeinträchtigen.";
"grbl.setting.13.detail" = "Zeigt Positionen und Geschwindigkeiten (außer Einstellungen) in Zoll an.";
"grbl.setting.20.detail" = "Aktiviert die Software-Endschalter innerhalb des Verfahrbereichs und löst bei Überschreitung Alarm aus. Erfordert Referenzfahrt.";
"grbl.setting.21.detail" = "Aktiviert Hardware-Endschalter. Stoppt sofort die Bewegung und löst Alarm aus, wenn ein Schalter auslöst.";
"grbl.setting.22.detail" = "Aktiviert die Referenzfahrt. Erfordert Endschalter an allen Achsen.";
"grbl.setting.23.detail" = "Die Referenzfahrt sucht den Schalter in positiver Richtung. Achsenbit (00000ZYX) setzen, um in negativer Richtung zu suchen.";
"grbl.setting.24.detail" = "Vorschub, mit dem der Endschalter langsam angefahren wird, um seine Position genau zu bestimmen.";
"grbl.setting.25.detail" = "Vorschub, mit dem der Endschalter vor der langsamen Phase schnell gesucht wird.";
"grbl.setting.26.detail" = "Kurze Pause zwischen den Phasen der Referenzfahrt, damit der Schalter entprellt.";
"grbl.setting.27.detail" = "Rückzugsstrecke nach dem Auslösen des Schalters, um ihn freizufahren. Die Referenzfahrt schlägt fehl, wenn der Schalter nicht frei wird.";
"grbl.setting.30.detail" = "Maximale Spindeldrehzahl. Entspricht 100 % PWM-Tastverhältnis (beim Laser: volle Leistung).";
"grbl.setting.31.detail" = "Minimale Spindeldrehzahl. Entspricht 0,4 % bzw. dem kleinsten Tastverhältnis.";
"grbl.setting.32.detail" = "Aktiviert den Lasermodus. Aufeinanderfolgende G1/G2/G3-Befehle halten nicht an, wenn sich die Leistung ändert.";
"grbl.setting.100.detail" = "X-Achse: Auflösung in Schritten pro Millimeter.";
"grbl.setting.101.detail" = "Y-Achse: Auflösung in Schritten pro Millimeter.";
"grbl.setting.102.detail" = "Z-Achse: Auflösung in Schritten pro Millimeter.";
"grbl.setting.110.detail" = "X-Achse: maximale Geschwindigkeit. Wird auch als Eilgang (G0) verwendet.";
"grbl.setting.111.detail" = "Y-Achse: maximale Geschwindigkeit. Wird auch als Eilgang (G0) verwendet.";
"grbl.setting.112.detail" = "Z-Achse: maximale Geschwindigkeit. Wird auch als Eilgang (G0) verwendet.";
"grbl.setting.120.detail" = "X-Achse: Beschleunigung. Dient der Bewegungsplanung, damit das Motormoment nicht überschritten wird und keine Schritte verloren gehen.";
"grbl.setting.121.detail" = "Y-Achse: Beschleunigung. Dient der Bewegungsplanung, damit das Motormoment nicht überschritten wird und keine Schritte verloren gehen.";
"grbl.setting.122.detail" = "Z-Achse: Beschleunigung. Dient der Bewegungsplanung, damit das Motormoment nicht überschritten wird und keine Schritte verloren gehen.";
"grbl.setting.130.detail" = "Maximaler Verfahrweg der X-Achse ab dem Referenzschalter. Bestimmt den gültigen Arbeitsraum für Software-Endschalter und die Suchstrecken der Referenzfahrt.";
"grbl.setting.131.detail" = "Maximaler Verfahrweg der Y-Achse ab dem Referenzschalter. Bestimmt den gültigen Arbeitsraum für Software-Endschalter und die Suchstrecken der Referenzfahrt.";
"grbl.setting.132.detail" = "Maximaler Verfahrweg der Z-Achse ab dem Referenzschalter. Bestimmt den gültigen Arbeitsraum für Software-Endschalter und die Suchstrecken der Referenzfahrt.";
